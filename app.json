{
  "expo": {
    "name": "Datariot",
    "slug": "datariot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B0D18"
    },
    "scheme": "com.datariot.app",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.datariot.app",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSCameraUsageDescription": "Datariot needs camera access to record educational videos",
        "NSMicrophoneUsageDescription": "Datariot needs microphone access to record educational videos",
        "NSPhotoLibraryUsageDescription": "Datariot needs photo library access to upload videos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "navigationBar": {
        "barStyle": "light-content",
        "backgroundColor": "#0B0D18"
      },
      "package": "com.datariot.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "baseUrl": ""
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Datariot to access your microphone for video recording.",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a533bf28-7645-4511-9170-4dc8fd7fcedf"
      }
    }
  }
}
