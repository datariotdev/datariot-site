{
  "name": "datariot",
  "version": "1.0.0",
  "main": "metro-entry.js",
  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=2048 expo start",
    "start:lan": "NODE_OPTIONS=--max-old-space-size=2048 expo start --lan",
    "start:tunnel": "EXPO_NO_REDIRECT_PAGE=1 NODE_OPTIONS=--max-old-space-size=2048 expo start --tunnel ngrok --go",
    "start:tunnel:dev": "EXPO_NO_REDIRECT_PAGE=1 NODE_OPTIONS=--max-old-space-size=2048 expo start --tunnel ngrok --dev-client",
    "android": "NODE_OPTIONS=--max-old-space-size=2048 expo start --android",
    "android:lan": "NODE_OPTIONS=--max-old-space-size=2048 expo start --android --lan",
    "android:tunnel": "NODE_OPTIONS=--max-old-space-size=2048 expo start --android --tunnel",
    "ios": "NODE_OPTIONS=--max-old-space-size=2048 expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "android:bare": "expo run:android",
    "ios:bare": "expo run:ios",
    "check:expo": "expo install --check",
    "export:web": "expo export --platform web",
    "build:apk": "eas build -p android --profile preview",
    "postinstall": "test -f ./ngrok && test -d node_modules/@expo/ngrok-bin-linux-x64 && cp ./ngrok node_modules/@expo/ngrok-bin-linux-x64/ngrok; patch-package",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:security": "node --experimental-strip-types tests/feed-security.test.mjs",
    "test:orvelis": "node scripts/test-orvelis.cjs",
    "build:web": "expo export --platform web --output-dir datariot-xyz && node scripts/prepare-web-export.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/audiowide": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/oxanium": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo-google-fonts/syncopate": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@supabase/supabase-js": "^2.39.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-contacts": "~58.0.9",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "nativewind": "^4.0.1",
    "openai": "^6.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~58.0.20",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
